# ┌─────────────────────────────────────────────────────────────────────────┐
# │  SureShopPH Backend — Environment Variables                              │
# │  Copy this file to ".env" and fill in real values.                       │
# │  Variables under "Required" must be set or the server will refuse to     │
# │  start (validate_env() runs in the FastAPI lifespan).                    │
# └─────────────────────────────────────────────────────────────────────────┘

# ────────────────── Required ──────────────────
SUPABASE_URL=your_project_url
SUPABASE_KEY=your_service_role_key
JWT_SECRET=your_jwt_secret

# ────────────────── CORS ──────────────────
# Comma-separated exact origins. Add your production frontend(s) here.
CORS_ALLOW_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://127.0.0.1
# Regex form for chrome-extension://<id> (the <id> changes per browser/install).
CORS_ALLOW_ORIGIN_REGEX=^chrome-extension://[a-z0-9]+$

# ────────────────── Request limits ──────────────────
# Maximum POST/PATCH body size in bytes (default 1 MB).
MAX_REQUEST_BYTES=1048576

# ────────────────── Scoring ──────────────────
# Score threshold above which a listing is persisted to high_risk_listings.
HIGH_RISK_PERSIST_THRESHOLD=60
# Below-market price threshold (PHP). Listings priced below this are flagged.
DEFAULT_PRICE_BASELINE=200
# Deep-scan blend weights. Must sum to 1.0.
DEEP_LISTING_WEIGHT=0.7
DEEP_COMMENTS_WEIGHT=0.3

# ────────────────── Logging ──────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
